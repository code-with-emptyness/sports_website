<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="100%" height="100%">
  <defs>
    <radialGradient id="rg_running" cx="50%" cy="40%" r="65%">
      <stop offset="0%" stop-color="#00dfd8" stop-opacity="0.25" />
      <stop offset="60%" stop-color="#007cf0" stop-opacity="0.08" />
      <stop offset="100%" stop-color="#0a0a0c" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="g_running" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00dfd8" />
      <stop offset="100%" stop-color="#007cf0" />
    </linearGradient>
    <pattern id="grid_running" width="24" height="24" patternUnits="userSpaceOnUse">
      <path d="M 24 0 L 0 0 0 24" fill="none" stroke="rgba(255,255,255,0.03)" stroke-width="1"/>
    </pattern>
  </defs>
  
  <!-- Base Background -->
  <rect width="100%" height="100%" fill="#0e0f12" />
  <rect width="100%" height="100%" fill="url(#grid_running)" />
  <rect width="100%" height="100%" fill="url(#rg_running)" />
  
  <!-- Outer Glow Ring -->
  <circle cx="300" cy="240" r="130" fill="none" stroke="url(#g_running)" stroke-width="1.5" stroke-opacity="0.3" stroke-dasharray="8 6" />
  
  <!-- Floating Glass Circle -->
  <circle cx="300" cy="240" r="105" fill="#14161b" stroke="rgba(255,255,255,0.12)" stroke-width="1.5" />
  <circle cx="300" cy="240" r="85" fill="url(#g_running)" opacity="0.12" />
  
  <!-- Main Sport Icon -->
  <text x="300" y="255" font-size="80" text-anchor="middle" dominant-baseline="central">🏃</text>
  
  <!-- Floating Spec Pill -->
  <rect x="180" y="375" width="240" height="30" rx="15" fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.12)" stroke-width="1" />
  <circle cx="198" cy="390" r="4" fill="#00dfd8" />
  <text x="305" y="395" font-family="'Outfit', sans-serif" font-weight="700" font-size="11" fill="#00dfd8" letter-spacing="2" text-anchor="middle">FARAN PRO SERIES</text>
  
  <!-- Headline Typography -->
  <text x="300" y="445" font-family="'Outfit', sans-serif" font-weight="800" font-size="22" fill="#ffffff" letter-spacing="1" text-anchor="middle">RUNNING & FITNESS</text>
  <text x="300" y="480" font-family="'Inter', sans-serif" font-size="13" fill="#8e95a5" text-anchor="middle">Cloud Cushion Shoes • Nike & Adidas Trainers</text>
  
  <!-- Bottom Accent Line -->
  <line x1="240" y1="515" x2="360" y2="515" stroke="url(#g_running)" stroke-width="2.5" stroke-linecap="round" />
</svg>